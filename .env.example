# ---- General ----
NODE_ENV=development
TZ=Asia/Kolkata

# ---- Database ----
POSTGRES_USER=receptionist
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=receptionist
DATABASE_URL=postgresql://receptionist:your_secure_postgres_password@localhost:5432/receptionist

# ---- Backend (Express) ----
BACKEND_PORT=3000
SERVICE_API_KEY=your_service_api_key_min_32_chars
JWT_SECRET=your_jwt_secret_min_32_chars

# ---- Agent (FastAPI) ----
AGENT_PORT=8000
BACKEND_BASE_URL=http://localhost:3000
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_token
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-2.5-flash

# ---- Documents / OCR ----
MAX_UPLOAD_MB=10
OCR_LANGS=eng+hin

# ---- Optional ----
N8N_WEBHOOK_URL=
SENTRY_DSN=
